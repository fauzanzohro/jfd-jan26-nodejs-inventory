
<%- include('../layout/menu_atas') %>
<%- include('../layout/side_bar') %>
<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
<h1 class="h2">Dashboard</h1>
</div>
<div class="card col-md-4 pb-2">
    <h1 class="h3 ms-2">Stok terakhir</h1>
    <ul class="list-group list-group-numbered ">
        
        <% for( let i = 0; i < stok_terakhir.length; i++ ) { %>
            <li class="list-group-item d-flex justify-content-between align-items-start fw-bold ms-2 me-2 bg-hover      <%= (stok_terakhir[i].stok_sisa<10?"text-bg-warning":"") %>" > 
                <%= stok_terakhir[i].kode %>
                <span class="badge bg-primary rounded-pill <%= (stok_terakhir[i].stok_sisa<10? "bg-danger": "bg-primary") %>"><%=stok_terakhir[i].stok_sisa  %></span>
            </li>
            <% } %>
        </ul>
    </div>

<%- include('../layout/footer') %>