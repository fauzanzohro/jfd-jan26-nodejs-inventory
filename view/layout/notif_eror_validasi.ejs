<% if (typeof pesanValidasi!== 'undefined') { %>
 <div class="m-3 alert alert-warning alert-dismissible fade show text-start" role="alert">
  <i class="fa-solid fa-exclamation-triangle"></i> <%= pesanValidasi[0].msg %>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>


