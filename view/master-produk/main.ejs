<%- include('../layout/menu_atas') %>
<%- include('../layout/side_bar') %>
<%- include('../layout/notif_message') %>
<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Master Product</h1>
</div>
<div class="card ">
    <div class="card-title p-1 ">
        <span class="h3">
            List Product
        </span>
        <a href="/master-produk/create" class="btn btn-sm btn-primary float-end m-1">
            <i class="fa-solid fa-plus"></i>
        </a>
    </div>
    <div class="card-body">
<table class="table table-hover table-bordered text-center">
    <thead>

        <tr>
            <th>Kode</th>
            <th>Nama</th>
            <th>Foto</th>
            <th>Aksi</th>
            
        </tr>
    </thead>
    <tbody>
        <% for( let i = 0; i < data_produk.length; i++ ) { %>
        
            <tr>
                <td><%= data_produk[i].kode %></td>
                <td><%= data_produk[i].nama %></td>
                        <td class="text-center">
                            <% if (data_produk[i].foto) { %>
                                <img src="/upload-image/<%= data_produk[i].foto %>" alt="foto produk <%= data_produk[i].nama %>" width="100">
                            <% } %>
                        </td>
                <td>
                    <a href="/master-produk/details/<%= data_produk[i].id %>" class="btn btn-sm btn-info">
                        <i class="fa-solid fa-eye"></i>Detail
                    </a>
                     <a href="/master-produk/edit/<%= data_produk[i].id %>" class="btn btn-sm btn-warning">
                        <i class="fa-regular fa-pen-to-square"></i>Edit
                    </a>
                     <a href="#" class="btn btn-sm btn-danger">
                        <i class="fa-solid fa-trash-can"></i>Hapus
                    </a>
                </td>
            </tr>
        <% } %>
    </tbody>
</table>
    </div>
</div>

<%- include('../layout/footer') %>