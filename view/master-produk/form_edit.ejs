<%- include('../layout/menu_atas') %>
<%- include('../layout/side_bar') %>
<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
<h1 class="h2">Edit Produk</h1>
</div>
<form action="/master-produk/proses-edit/<%= data_produk[0].id %>" method="post" enctype="multipart/form-data">
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label  class="form-label">Kode Barang</label>
                <input name="form_kode_barang" value="<%= data_produk[0].kode %>" type="text" class="form-control" >
            </div>
            
            <div class="mb-3">
                <label  class="form-label">Nama Barang</label>
                <input type="text" name="form_nama_barang" value="<%= data_produk[0].nama %>" class="form-control" >
            </div>
            
            <div class="mb-3">
                <label class="form-label">Deskripsi</label>
                <textarea name="form_deskripsi"  rows="10" class="form-control"> <%= data_produk[0].deskripsi %></textarea>
            <div class="mb-3">
                <label class="form-label">Foto Produk</label><br>
                <img src="/upload-image/<%= data_produk[0].foto %>" alt="" width="500px">
                <input type="file" name="form_upload_foto"id="add_foto">
                <div id="preview_foto" class="align-items-center"></div>
            </div>

            <button type="submit" class="btn btn-primary" >Update</button>
        </div>
        </div>
</form>

<script>
    $('#add_foto').on('change', function() {
        let add_foto = $('#add_foto').val()
        if (this.files[0]) {
            let type    = this.files[0].type
            let size    = this.files[0].size
            let maxsize = (5120 * 1024)
            if (size > maxsize) {
                // $('#submit_edit_foto').prop('disabled', true)
                $('#preview_foto').empty()
                // $('#edit_infouploadfoto').empty().append(`<i class="fe fe-16 fe-alert-triangle text-danger"></i> <span class="text-danger">File size exceeds the limit: 5 MB.</span>`)
            } else {
                // $('#submit_edit_foto').prop('disabled', false)
                // $('#edit_infouploadfoto').empty()
                if (add_foto && type.split('/')[0] == 'image') {
                    $('#preview_foto').empty().append(
                        `<img src="${window.URL.createObjectURL(this.files[0])}" class="w-100" alt="foto profil user">`
                    )
                }
            }
        } else {
            // $('#submit_edit_foto').prop('disabled', false)
            $('#preview_foto').empty()
        }
    })
</script>
<%- include('../layout/footer') %>