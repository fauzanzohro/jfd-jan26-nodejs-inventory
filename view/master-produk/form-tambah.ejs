<%- include('../layout/menu_atas') %>
<%- include('../layout/side_bar') %>
<%- include('../layout/notif_message') %>
<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">

<h1 class="h2">Tambah Produk</h1>
</div>
<form action="/master-produk/insert" method="post">
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label  class="form-label">Kode Barang</label>
                <input name="form_kode_barang" type="text" class="form-control" >
            </div>
            
            <div class="mb-3">
                <label  class="form-label">Nama Barang</label>
                <input type="text" name="form_nama_barang" class="form-control" >
            </div>
            
            <div class="mb-3">
                <label class="form-label">Deskripsi</label>
                <textarea name="form_deskripsi" rows="10" class="form-control"></textarea>
            </div>
            
            <button type="submit" class="btn btn-primary" >Simpan</button>
            
        </div>
        </div>
</form>
