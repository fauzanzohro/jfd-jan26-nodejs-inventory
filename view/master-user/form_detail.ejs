<%- include('../layout/menu_atas') %>
<%- include('../layout/side_bar') %>
<div class="d-flex flex-coloumn justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
<h1 class="h2">Master User</h1>
</div>
<table class="table table-hover table-bordered text-center">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Password</th>
                    <th>id_karyawan</th>
                    <th>Role</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
        <% if (satu_user.length>0) { %>
                    <tr>
                        <td> <%= satu_user[0].username %></td>
                        <td><%=  satu_user[0].password %></td>
                        <td><%=  satu_user[0].id_karyawan %></td>
                        <td><%=  satu_user[0].role %></td>
                        <td>
                            <a href="/master-user/edit/<%=satu_user[0].id %>" class="btn btn-warning" >Edit</a>
                        </td>                
                    </tr>
                <% } %>
            </tbody>
        </table>

<%- include('../layout/footer') %>