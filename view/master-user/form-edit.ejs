<%- include('../layout/menu_atas') %>
<%- include('../layout/side_bar') %>
<div class="d-flex flex-coloumn justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
<h1 class="h2">Master User</h1>
</div>
<h1>ini form edit user</h1>
<form action="/master-user/proses-edit/<%= edit_user[0].id %>" method="post">
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label  class="form-label">Username</label>
                <input name="" value="<%= edit_user[0].username %>" type="text" class="form-control" >
            </div>
            
            <div class="mb-3">
                <label  class="form-label">password</label>
                <input type="text" name="" value="<%= edit_user[0].password %>" class="form-control" >
            </div>
            
            <div class="mb-3">
                <label class="form-label">id_karyawan</label>
                <input type="text" name="" value="<%= edit_user[0].id_karyawan %>" class="form-control" >
            </div>      
            <div class="mb-3">
                <label class="form-label">Role</label>
                <select name="">
                    <option value="">--pilih--</option>
                    <% for( let i = 0; i < role.length; i++ ) { %>
                    <option 
                        value="<%= role[i].role %>"
                        <%= edit_user[0].role === role[i].role ? 'selected' : '' %>>
                        <%= role[i].role %>
                    </option>
                    
                    <% } %>
                </select>

            </div>
            
            <button type="submit" class="btn btn-primary" >Update</button>
        </div>
        </div>
</form>
<%- include('../layout/footer') %>
